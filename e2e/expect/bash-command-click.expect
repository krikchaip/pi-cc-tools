#!/usr/bin/expect -f
# Real-Pi fullscreen regression for standalone expanded Bash command clicks.

set timeout 1
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set extension_path [file join $repo_dir "extensions" "index.ts"]
set fixture_path [file join $repo_dir "e2e" "fixtures" "bash-command-click-standalone-session.jsonl"]
set assert_path [file join $expect_dir "async-diff-click-assert.py"]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set scratch "/tmp/pi-cc-tools-bash-command-click-[pid]"
set cwd [file join $scratch "cwd"]
set home [file join $scratch "home"]
set agent [file join $scratch "agent"]
set columns 100
set rows 40
file mkdir $cwd
file mkdir [file join $home ".pi"]
file mkdir $agent

set fixture [open $fixture_path "r"]
set content [read $fixture]
close $fixture
set session_path [file join $scratch "session.jsonl"]
set session [open $session_path "w"]
puts -nonewline $session [string map [list "/tmp/pi-cc-tools-bash-command-click" $cwd] $content]
close $session

set settings_json {{"quietStartup":true,"theme":"dark","outputPad":0,"clickExpansion":true,"groupToolCalls":true}}
foreach path [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]] {
  set settings [open $path "w"]
  puts $settings $settings_json
  close $settings
}

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc drain_repaint {} {
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
}

proc force_fullscreen_repaint {columns rows} {
  global spawn_id
  set pi_pid [exp_pid]
  if {[catch {exec stty columns [expr {$columns + 1}] rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  drain_repaint
  if {[catch {exec stty columns $columns rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  drain_repaint
  return 1
}

proc fail {message scratch} {
  puts stderr $message
  send "\003\003"
  catch {close}
  catch {wait}
  catch {log_file}
  puts stderr "ARTIFACTS $scratch"
  exit 1
}

puts "PI_VERSION [exec $pi_bin --version]"
cd $cwd
log_file -noappend [file join $scratch "startup.ansi"]
spawn env HOME=$home TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent \
  $pi_bin --session $session_path --no-context-files --no-prompt-templates --no-themes --no-extensions --no-skills \
  -e $extension_path --tui-mode fullscreen
stty columns $columns rows $rows

if {![wait_for 10 {click.*to expand}]} { fail "standalone Bash fixture did not become ready" $scratch }
# The compact result summary is row 4.
send -- "\033\[<0;12;4M\033\[<0;12;4m"
if {![wait_for 5 {STANDALONE_COMMAND_CONTINUATION}]} { fail "standalone Bash did not expand" $scratch }

# The first full command line is row 4 after expansion.
log_file
log_file -noappend [file join $scratch "collapse-transition.ansi"]
send -- "\033\[<0;8;4M\033\[<0;8;4m"
if {![wait_for 5 {click.*to expand}]} { fail "standalone full Bash command text did not collapse its execution" $scratch }
set collapsed_path [file join $scratch "collapsed.ansi"]
log_file
log_file -noappend $collapsed_path
if {![force_fullscreen_repaint $columns $rows]} { fail "standalone collapsed capture failed" $scratch }
log_file

if {![catch {exec python3 $assert_path final-contains $collapsed_path "STANDALONE_COMMAND_CONTINUATION"}]} {
  fail "standalone command continuation remained visible after command click" $scratch
}
send "\003\003"
catch {close}
catch {wait}
file delete -force $scratch
puts "PASS standalone expanded Bash command text collapses its execution"

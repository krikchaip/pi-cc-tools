#!/usr/bin/expect -f
# Real-Pi regression for a standalone Bash execution-summary click routed
# through an isolated tmux client while the agent is still working.

set timeout 1
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set provider_path [file join $repo_dir "e2e" "fixtures" "preserved-bash-completion-provider.ts"]
set overlay_path [file join $repo_dir "e2e" "fixtures" "passive-overlay.ts"]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set scratch "/tmp/pi-cc-tools-active-bash-execution-tmux-[pid]"
set socket "pi-cc-tools-active-bash-execution-[pid]"
set session "active-bash-execution"
set cwd [file join $scratch "cwd"]
set home [file join $scratch "home"]
set agent [file join $scratch "agent"]
set capture_path [file join $scratch "tmux-client.ansi"]
set columns 100
set rows 40
file mkdir $cwd
file mkdir [file join $home ".pi"]
file mkdir $agent

set settings_json [format {{"quietStartup":true,"theme":"dark","outputPad":1,"toolBackground":"outlines","clickExpansion":true,"groupToolCalls":true,"liveToolPreview":true,"liveToolPreviewLines":3,"thinkingMode":"full","hideThinkingBlock":false,"packages":["%s"]}} $repo_dir]
foreach path [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]] {
  set settings [open $path "w"]
  puts $settings $settings_json
  close $settings
}

proc tmux_command {socket args} {
  return [exec env -u TMUX -u TMUX_PANE tmux -L $socket {*}$args]
}

proc shell_quote {value} {
  return "'[string map [list ' '\\''] $value]'"
}

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      "install missing project packages" { puts stderr "unexpected package prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc stop_tmux {socket} {
  catch {exec env -u TMUX -u TMUX_PANE tmux -L $socket kill-server}
}

proc fail {message scratch socket} {
  puts stderr $message
  catch {send "\003\003"}
  catch {close}
  catch {wait}
  catch {log_file}
  stop_tmux $socket
  puts stderr "ARTIFACTS $scratch"
  exit 1
}

proc locate_bash_execution {socket pane} {
  set screen [tmux_command $socket capture-pane -p -t $pane]
  set row 0
  foreach line [split $screen "\n"] {
    incr row
    if {[string first "● Bash" $line] < 0} continue
    set column [string first "Bash" $line]
    if {$column >= 0} { return [list [expr {$column + 1}] $row] }
  }
  error "no visible standalone Bash execution summary"
}

proc physical_click {socket pane} {
  lassign [locate_bash_execution $socket $pane] local_column local_row
  set pane_left [tmux_command $socket display-message -p -t $pane "#{pane_left}"]
  set pane_top [tmux_command $socket display-message -p -t $pane "#{pane_top}"]
  set target_column [expr {$pane_left + $local_column}]
  set target_row [expr {1 + $pane_top + $local_row}]
  puts "TMUX_TARGET pane=$pane local=${local_column},${local_row} screen=${target_column},${target_row}"
  send -- "\033\[<0;${target_column};${target_row}M\033\[<0;${target_column};${target_row}m"
}

puts "PI_VERSION [exec $pi_bin --version]"
set pi_command [list env HOME=$home COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent ACTIVE_BASH_THINKING_STREAM=1 ACTIVE_BASH_LONG_TRANSCRIPT=1 \
  $pi_bin --no-session --no-context-files --no-prompt-templates --no-themes --no-skills --approve]
lappend pi_command -e $overlay_path -e $provider_path \
  --provider preserved-bash-completion-e2e --model deterministic-bash --api-key e2e-local \
  --tui-mode fullscreen "Run the deterministic Bash fixture."
set quoted_command {}
foreach value $pi_command { lappend quoted_command [shell_quote $value] }
set shell_command [join $quoted_command " "]

stop_tmux $socket
tmux_command $socket -f /dev/null new-session -d -s $session -c $cwd -x $columns -y $rows /bin/bash
tmux_command $socket set-option -g mouse on
tmux_command $socket set-option -g status on
tmux_command $socket set-option -g status-position top
tmux_command $socket set-option -g default-shell /bin/bash
tmux_command $socket set-option -g default-terminal tmux-256color
tmux_command $socket set-window-option -t $session window-size manual
set pi_pane [tmux_command $socket display-message -p -t $session "#{pane_id}"]

log_user 0
log_file -a -noappend $capture_path
spawn env -u TMUX -u TMUX_PANE TERM=xterm-kitty COLORTERM=truecolor COLUMNS=$columns LINES=$rows \
  /bin/bash -c "stty columns $columns rows $rows; exec tmux -L $socket attach-session -t $session"
after 300
tmux_command $socket resize-window -t $session -x $columns -y $rows
after 300
tmux_command $socket send-keys -t $pi_pane -l $shell_command
tmux_command $socket send-keys -t $pi_pane Enter

if {![wait_for 12 {Done.*24 lines.*click.*to expand}]} {
  log_user 1
  fail "tmux fixture did not expose its completed Bash execution" $scratch $socket
}
if {![wait_for 3 {ACTIVE_BASH_THINKING_STREAM}]} {
  log_user 1
  fail "tmux fixture did not start continuous thinking repaints" $scratch $socket
}
send -- "\033\[<64;5;20M"
if {![wait_for 2 {Jump to latest message}]} {
  log_user 1
  fail "tmux fixture did not enter a scrolled viewport" $scratch $socket
}
if {[catch {physical_click $socket $pi_pane} click_error]} {
  log_user 1
  fail "could not click the tmux Bash execution summary: $click_error" $scratch $socket
}
if {![wait_for 3 {BASH_PRESERVED_01}]} {
  log_user 1
  fail "standalone Bash execution summary ignored its expand click through tmux" $scratch $socket
}
if {[wait_for 1 {E2E_BASH_PRESERVED_COMPLETE}]} {
  log_user 1
  fail "Bash execution expanded only after the active provider turn ended" $scratch $socket
}

after 600
if {[catch {physical_click $socket $pi_pane} click_error]} {
  log_user 1
  fail "could not click the expanded tmux Bash execution summary: $click_error" $scratch $socket
}
if {![wait_for 3 {Done.*24 lines.*click.*to expand}]} {
  log_user 1
  fail "expanded Bash execution summary ignored its collapse click through tmux" $scratch $socket
}

catch {send "\003\003"}
catch {close}
catch {wait}
catch {log_file}
stop_tmux $socket
puts "ARTIFACTS $scratch"
puts "PASS standalone Bash execution summary expands and collapses through tmux during an active agent turn"

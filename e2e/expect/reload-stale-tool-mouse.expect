#!/usr/bin/expect -f
# Real-Pi fullscreen regression: /reload repairs a retained stale tool mouse handler.

set timeout 1
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set extension_path [file join $repo_dir "extensions" "index.ts"]
set poison_path [file join $repo_dir "e2e" "fixtures" "stale-tool-mouse-handler.ts"]
set fixture_path [file join $repo_dir "e2e" "fixtures" "bash-command-click-standalone-session.jsonl"]
set locator_path [file join $expect_dir "async-diff-click-assert.py"]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set scratch "/tmp/pi-cc-tools-reload-stale-tool-mouse-[pid]"
set cwd [file join $scratch "cwd"]
set home [file join $scratch "home"]
set agent [file join $scratch "agent"]
set columns 100
set rows 40
file mkdir $cwd
file mkdir [file join $home ".pi"]
file mkdir $agent

set fixture [open $fixture_path "r"]
set content [read $fixture]
close $fixture
set session_path [file join $scratch "session.jsonl"]
set session [open $session_path "w"]
puts -nonewline $session [string map [list "/tmp/pi-cc-tools-bash-command-click" $cwd] $content]
close $session

set settings_json [format {{"quietStartup":true,"theme":"dark","outputPad":0,"clickExpansion":true,"groupToolCalls":false,"extensions":["%s","%s"]}} $extension_path $poison_path]
foreach path [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]] {
  set settings [open $path "w"]
  puts $settings $settings_json
  close $settings
}

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc force_fullscreen_repaint {columns rows} {
  global spawn_id
  set pi_pid [exp_pid]
  if {[catch {exec stty columns [expr {$columns + 1}] rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
  if {[catch {exec stty columns $columns rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
  return 1
}

proc fail {message scratch} {
  puts stderr $message
  catch {send "\003\003"}
  catch {close}
  catch {wait}
  catch {log_file}
  puts stderr "ARTIFACTS $scratch"
  exit 1
}

puts "PI_VERSION [exec $pi_bin --version]"
cd $cwd
log_user 0
log_file -noappend [file join $scratch "session.ansi"]
spawn env HOME=$home TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent \
  $pi_bin --session $session_path --no-context-files --no-prompt-templates --no-themes --no-skills --tui-mode fullscreen
stty columns $columns rows $rows

if {![wait_for 10 {Done.*10 lines.*click.*to expand}]} {
  log_user 1
  fail "standalone Bash fixture did not expose its click anchor" $scratch
}
send -- "/e2e-poison-tool-mouse\r"
if {![wait_for 5 {E2E_STALE_TOOL_MOUSE_HANDLER}]} {
  log_user 1
  fail "stale mouse fixture did not replace the tool handler" $scratch
}
send -- "/reload\r"
if {![wait_for 10 {Reloaded keybindings, extensions, skills, prompts, themes, and context files}]} {
  log_user 1
  fail "/reload did not complete after poisoning the tool handler" $scratch
}

# The compact standalone Bash result summary stays on row 4 at 100x40.
log_file
log_file -noappend [file join $scratch "post-reload-click.ansi"]
send -- "\033\[<0;12;4M\033\[<0;12;4m"
if {![wait_for 5 {STANDALONE_RESULT_01}]} {
  log_user 1
  fail "/reload did not repair the retained Bash mouse handler" $scratch
}

catch {send "\003\003"}
catch {close}
catch {wait}
catch {log_file}
puts "ARTIFACTS $scratch"
puts "PASS /reload repairs a retained stale tool mouse handler"

#!/usr/bin/expect -f
# Real-Pi fullscreen regression: click anchors work when cc-tools is first loaded by /reload.

set timeout 1
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set fixture_path [file join $repo_dir "e2e" "fixtures" "bash-command-click-standalone-session.jsonl"]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set scratch "/tmp/pi-cc-tools-late-load-bash-click-[pid]"
set cwd [file join $scratch "cwd"]
set home [file join $scratch "home"]
set agent [file join $scratch "agent"]
set columns 100
set rows 40
file mkdir $cwd
file mkdir [file join $home ".pi"]
file mkdir $agent

set fixture [open $fixture_path "r"]
set content [read $fixture]
close $fixture
set session_path [file join $scratch "session.jsonl"]
set session [open $session_path "w"]
puts -nonewline $session [string map [list "/tmp/pi-cc-tools-bash-command-click" $cwd] $content]
close $session

proc write_settings {paths content} {
  foreach path $paths {
    set settings [open $path "w"]
    puts $settings $content
    close $settings
  }
}

set settings_paths [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]]
write_settings $settings_paths {{"quietStartup":true,"theme":"dark","outputPad":0,"clickExpansion":true,"groupToolCalls":true,"packages":[]}}

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      "install missing project packages" { puts stderr "unexpected package prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc fail {message scratch} {
  puts stderr $message
  catch {send "\003\003"}
  catch {close}
  catch {wait}
  catch {log_file}
  puts stderr "ARTIFACTS $scratch"
  exit 1
}

puts "PI_VERSION [exec $pi_bin --version]"
cd $cwd
log_user 0
log_file -noappend [file join $scratch "late-load.ansi"]
spawn env HOME=$home TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent \
  $pi_bin --session $session_path --no-context-files --no-prompt-templates --no-themes --no-skills --tui-mode fullscreen
stty columns $columns rows $rows

if {![wait_for 10 {STANDALONE_RESULT_10}]} {
  log_user 1
  fail "stock Bash fixture did not become ready before late load" $scratch
}

set enabled_settings [format {{"quietStartup":true,"theme":"dark","outputPad":0,"clickExpansion":true,"groupToolCalls":true,"packages":["%s"]}} $repo_dir]
write_settings $settings_paths $enabled_settings
send -- "/reload\r"
if {![wait_for 10 {Reloaded keybindings, extensions, skills, prompts, themes, and context files}]} {
  log_user 1
  fail "/reload did not load cc-tools into the running session" $scratch
}
if {![wait_for 5 {click.*to expand}]} {
  log_user 1
  fail "late-loaded cc-tools did not render its Bash click anchor" $scratch
}

# The compact standalone Bash result summary is row 4 at 100x40.
send -- "\033\[<0;12;4M\033\[<0;12;4m"
if {![wait_for 5 {STANDALONE_COMMAND_CONTINUATION}]} {
  log_user 1
  fail "late-loaded Bash click anchor ignored its click" $scratch
}

catch {send "\003\003"}
catch {close}
catch {wait}
catch {log_file}
puts "ARTIFACTS $scratch"
puts "PASS Bash click anchors work when cc-tools is first loaded by /reload"

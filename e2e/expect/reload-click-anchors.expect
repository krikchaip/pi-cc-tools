#!/usr/bin/expect -f
# Real-Pi fullscreen regression: click anchors survive /reload.

set timeout 1
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set fixture_path [file join $repo_dir "e2e" "fixtures" "effective-final-level-one-session.jsonl"]
set extension_path [file join $repo_dir "extensions" "index.ts"]
set locator_path [file join $expect_dir "async-diff-click-assert.py"]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set scratch "/tmp/pi-cc-tools-reload-click-[pid]"
set cwd [file join $scratch "cwd"]
set home [file join $scratch "home"]
set agent [file join $scratch "agent"]
set session_path [file join $scratch "session.jsonl"]
set columns 100
set rows 40
file mkdir $cwd
file mkdir [file join $home ".pi"]
file mkdir $agent

set settings_json [format {{"quietStartup":true,"theme":"dark","outputPad":0,"clickExpansion":true,"previewLines":3,"expandedPreviewMaxLines":50,"extraExpandedPreviewMaxLines":100,"groupToolCalls":true,"extensions":["%s"]}} $extension_path]
foreach path [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]] {
  set settings [open $path "w"]
  puts $settings $settings_json
  close $settings
}

set source [open $fixture_path "r"]
set content [read $source]
close $source
set session [open $session_path "w"]
puts -nonewline $session [string map [list "/tmp/pi-cc-tools-result-summary-acceptance" $cwd] $content]
close $session

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc stop_pi {} {
  send "\003\003"
  catch {close}
  catch {wait}
  log_file
}

proc force_fullscreen_repaint {columns rows} {
  global spawn_id
  set pi_pid [exp_pid]
  if {[catch {exec stty columns [expr {$columns + 1}] rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
  if {[catch {exec stty columns $columns rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
  return 1
}

proc capture {path columns rows} {
  log_file
  log_file -noappend $path
  if {![force_fullscreen_repaint $columns $rows]} { return 0 }
  log_file
  return 1
}

proc locate {locator_path path token} {
  if {[catch {exec python3 $locator_path locate $path $token} point]} { return {} }
  return $point
}

proc click_point {point} {
  lassign $point x y
  send -- "\033\[<0;${x};${y}M\033\[<0;${x};${y}m"
}

puts "PI_VERSION [exec $pi_bin --version]"
cd $cwd
log_file -noappend [file join $scratch "startup.ansi"]
spawn env HOME=$home TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent \
  $pi_bin --session $session_path --no-context-files --no-prompt-templates --no-themes --no-skills --tui-mode fullscreen
stty columns $columns rows $rows

if {![wait_for 10 {click.*to expand}]} {
  puts stderr "reload fixture did not become ready"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

# Prove the initial extension instance accepts the visible result-summary row.
set before_reload_frame [file join $scratch "before-reload-frame.ansi"]
if {![capture $before_reload_frame $columns $rows]} {
  puts stderr "could not capture the initial compact frame"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set summary_point [locate $locator_path $before_reload_frame "6 lines loaded"]
if {[llength $summary_point] != 2} {
  puts stderr "could not locate the initial result-summary anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
click_point $summary_point
if {![wait_for 5 {image4 payload 03}]} {
  puts stderr "click anchor did not work before reload"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

# Return to compact state before reload.
set expanded_before_reload [file join $scratch "expanded-before-reload.ansi"]
if {![capture $expanded_before_reload $columns $rows]} {
  puts stderr "could not capture the initial expanded frame"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set summary_point [locate $locator_path $expanded_before_reload "6 lines loaded"]
if {[llength $summary_point] != 2} {
  puts stderr "could not relocate the expanded result-summary anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
click_point $summary_point
after 300
if {![force_fullscreen_repaint $columns $rows]} {
  puts stderr "could not repaint compact state before reload"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

log_file
log_file -noappend [file join $scratch "reload.ansi"]
send -- "/reload\r"
if {![wait_for 10 {Reloaded keybindings, extensions, skills, prompts, themes, and context files}]} {
  puts stderr "/reload did not complete"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
after 300
if {![force_fullscreen_repaint $columns $rows]} {
  puts stderr "could not repaint after reload"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

# Isolate post-reload input so startup or pre-reload payload cannot satisfy it.
set post_reload_frame [file join $scratch "post-reload-frame.ansi"]
if {![capture $post_reload_frame $columns $rows]} {
  puts stderr "could not capture the post-reload compact frame"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set summary_point [locate $locator_path $post_reload_frame "6 lines loaded"]
if {[llength $summary_point] != 2} {
  puts stderr "could not locate the post-reload result-summary anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
log_file -noappend [file join $scratch "post-reload-click.ansi"]
click_point $summary_point
if {![wait_for 5 {image4 payload 03}]} {
  puts stderr "top click anchor stopped working after /reload"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
if {![wait_for 5 {click.*for more detail}]} {
  puts stderr "post-reload normal preview had no detail anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

# Reach the effective final layer, then activate its bottom collapse anchor.
set detail_frame [file join $scratch "post-reload-detail-frame.ansi"]
if {![capture $detail_frame $columns $rows]} {
  puts stderr "could not capture the post-reload detail frame"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set detail_point [locate $locator_path $detail_frame "click for more detail"]
if {[llength $detail_point] != 2} {
  puts stderr "could not locate the post-reload detail anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
click_point $detail_point
if {![wait_for 5 {click.*to collapse}]} {
  puts stderr "post-reload detail anchor did not reveal the bottom collapse anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set bottom_frame [file join $scratch "post-reload-bottom-frame.ansi"]
if {![capture $bottom_frame $columns $rows]} {
  puts stderr "could not capture the post-reload bottom frame"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set bottom_point [locate $locator_path $bottom_frame "Output ends here"]
if {[llength $bottom_point] != 2} {
  puts stderr "could not locate the post-reload bottom anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set bottom_log [file join $scratch "post-reload-bottom-click.ansi"]
log_file -noappend $bottom_log
click_point $bottom_point
if {![wait_for 5 {click.*to expand}]} {
  puts stderr "bottom click anchor stopped working after /reload"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
if {![force_fullscreen_repaint $columns $rows]} {
  puts stderr "could not repaint after post-reload bottom collapse"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
log_file
set capture_file [open $bottom_log "r"]
fconfigure $capture_file -encoding utf-8
set bottom_capture [read $capture_file]
close $capture_file
if {[string first "image4 payload" $bottom_capture] >= 0
    || [regexp {click.*to collapse} $bottom_capture]} {
  puts stderr "bottom click anchor retained expanded output after /reload"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

# The reloaded command must update the retained renderer and mouse adapter now,
# not after the old extension generation's five-second settings cache expires.
send -- "/cc-tools click off\r"
if {![wait_for 5 {Click expansion: off}]} {
  puts stderr "post-reload click-off command did not complete"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
log_file
set click_off_log [file join $scratch "post-reload-click-off.ansi"]
log_file -noappend $click_off_log
if {![force_fullscreen_repaint $columns $rows]} {
  puts stderr "could not repaint after post-reload click-off command"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
log_file
if {[catch {exec python3 $locator_path final-contains $click_off_log "ctrl+o to expand"}]
    || ![catch {exec python3 $locator_path final-contains $click_off_log "click to expand"}]} {
  puts stderr "retained renderer kept click guidance after post-reload click-off command"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set disabled_summary_point [locate $locator_path $click_off_log "6 lines loaded"]
if {[llength $disabled_summary_point] != 2} {
  puts stderr "could not locate the disabled result-summary row"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
log_file -noappend [file join $scratch "post-reload-disabled-click.ansi"]
click_point $disabled_summary_point
if {[wait_for 1 {image4 payload 03}]} {
  puts stderr "retained mouse adapter accepted a disabled click after /reload"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

send -- "/cc-tools click on\r"
if {![wait_for 5 {Click expansion: on}]} {
  puts stderr "post-reload click-on command did not complete"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set reenabled_frame [file join $scratch "post-reload-reenabled-frame.ansi"]
if {![capture $reenabled_frame $columns $rows]} {
  puts stderr "could not capture the re-enabled result-summary row"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
if {[catch {exec python3 $locator_path final-contains $reenabled_frame "click to expand"}]} {
  puts stderr "retained renderer did not restore click guidance after post-reload click-on command"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
set reenabled_summary_point [locate $locator_path $reenabled_frame "6 lines loaded"]
if {[llength $reenabled_summary_point] != 2} {
  puts stderr "could not locate the re-enabled result-summary anchor"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}
log_file -noappend [file join $scratch "post-reload-reenabled-click.ansi"]
click_point $reenabled_summary_point
if {![wait_for 5 {image4 payload 03}]} {
  puts stderr "retained mouse adapter did not restore clicks after post-reload click-on command"
  stop_pi
  puts "ARTIFACTS $scratch"
  exit 1
}

stop_pi
puts "RELOAD_CLICK_ANCHORS_PASS"
file delete -force $scratch
exit 0

#!/usr/bin/expect -f
# Real-Pi fullscreen regression for top and bottom click-anchor viewport invariants.

set timeout 1
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set extension_path [file join $repo_dir "extensions" "index.ts"]
set fixture_path [file join $repo_dir "e2e" "fixtures" "collapse-scroll-position-session.jsonl"]
set assert_path [file join $expect_dir "click-viewport-anchors-assert.py"]
set locator_path [file join $expect_dir "async-diff-click-assert.py"]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set scratch "/tmp/pi-cc-tools-click-viewport-anchors-[pid]"
set cwd [file join $scratch "cwd"]
set home [file join $scratch "home"]
set agent [file join $scratch "agent"]
set columns 100
set rows 40
file mkdir $cwd
file mkdir [file join $home ".pi"]
file mkdir $agent

set settings_json {{"quietStartup":true,"theme":"dark","outputPad":0,"clickExpansion":true,"previewLines":3,"expandedPreviewMaxLines":100,"extraExpandedPreviewMaxLines":200,"groupToolCalls":false}}
foreach path [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]] {
  set settings [open $path "w"]
  puts $settings $settings_json
  close $settings
}
set source [open $fixture_path "r"]
set content [read $source]
close $source
set session_path [file join $scratch "session.jsonl"]
set session [open $session_path "w"]
puts -nonewline $session [string map [list "/tmp/pi-cc-tools-collapse-scroll-position" $cwd] $content]
close $session

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc drain_repaint {} {
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
}

proc force_fullscreen_repaint {columns rows} {
  global spawn_id
  set pi_pid [exp_pid]
  if {[catch {exec stty columns [expr {$columns + 1}] rows $rows <@ $spawn_id} error]} {
    puts stderr "could not widen Pi PTY: $error"
    return 0
  }
  catch {exec kill -WINCH $pi_pid}
  drain_repaint
  if {[catch {exec stty columns $columns rows $rows <@ $spawn_id} error]} {
    puts stderr "could not restore Pi PTY: $error"
    return 0
  }
  catch {exec kill -WINCH $pi_pid}
  drain_repaint
  return 1
}

proc capture {path columns rows} {
  log_file
  log_file -noappend $path
  if {![force_fullscreen_repaint $columns $rows]} { return 0 }
  return 1
}

proc fail {message scratch} {
  puts stderr $message
  send "\003\003"
  catch {close}
  catch {wait}
  log_file
  puts "ARTIFACTS $scratch"
  exit 1
}

puts "PI_VERSION [exec $pi_bin --version]"
cd $cwd
log_file -noappend [file join $scratch "startup.ansi"]
spawn env HOME=$home TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent \
  $pi_bin --session $session_path --no-context-files --no-prompt-templates --no-themes --no-extensions --no-skills \
  -e $extension_path --tui-mode fullscreen
stty columns $columns rows $rows

if {![wait_for 10 {UNRELATED_AFTER_FINAL}]} { fail "fixture did not become ready" $scratch }
send -- "\033\[5~"
if {![wait_for 2 {click.*to expand}]} { fail "could not scroll to collapsed Read" $scratch }
if {![capture [file join $scratch "top-before-expand.ansi"] $columns $rows]} { fail "could not capture top-before-expand" $scratch }

# The result summary is the top anchor at row 13.
log_file
log_file -noappend [file join $scratch "top-expand-transition.ansi"]
send -- "\033\[<0;15;13M\033\[<0;15;13m"
if {![wait_for 3 {click.*for more detail}]} { fail "normal preview did not open" $scratch }
if {![capture [file join $scratch "top-after-expand.ansi"] $columns $rows]} { fail "could not capture top-after-expand" $scratch }

# The same result summary is still the top anchor. Its collapse must not move
# transcript rows above it.
log_file
log_file -noappend [file join $scratch "top-collapse-transition.ansi"]
send -- "\033\[<0;15;13M\033\[<0;15;13m"
if {![wait_for 3 {click.*to expand}]} { fail "top-anchor collapse did not settle" $scratch }
if {![capture [file join $scratch "top-after-collapse.ansi"] $columns $rows]} { fail "could not capture top-after-collapse" $scratch }

# The top invariant keeps the result summary on row 13, so reopen it and the
# effective final layer. Locate the detail action from a complete frame because
# boundary clamping can change its screen row. Then place the bottom anchor in view.
log_file
send -- "\033\[<0;15;13M\033\[<0;15;13m"
if {![wait_for 3 {click.*for more detail}]} { fail "normal preview did not reopen" $scratch }
set reopened_capture [file join $scratch "top-reopened.ansi"]
if {![capture $reopened_capture $columns $rows]} { fail "could not capture reopened normal preview" $scratch }
if {[catch {exec python3 $locator_path locate $reopened_capture "click for more detail"} detail_point]} {
  fail "could not locate reopened detail action: $detail_point" $scratch
}
lassign $detail_point detail_x detail_y
send -- "\033\[<0;${detail_x};${detail_y}M\033\[<0;${detail_x};${detail_y}m"
if {![wait_for 3 {COLLAPSE_SCROLL_PAYLOAD_04}]} { fail "final detail layer did not open" $scratch }
send -- "\033\[6~"
wait_for 1 {COLLAPSE_SCROLL_PAYLOAD}
send -- "\033\[6~"
if {![wait_for 2 {click.*to collapse}]} { fail "bottom anchor did not enter viewport" $scratch }
if {![capture [file join $scratch "bottom-before-collapse.ansi"] $columns $rows]} { fail "could not capture bottom-before-collapse" $scratch }

log_file
log_file -noappend [file join $scratch "bottom-collapse-transition.ansi"]
send -- "\033\[<0;25;24M\033\[<0;25;24m"
if {![wait_for 3 {click.*to expand}]} { fail "bottom-anchor collapse did not settle" $scratch }
if {![capture [file join $scratch "bottom-after-collapse.ansi"] $columns $rows]} { fail "could not capture bottom-after-collapse" $scratch }

send "\003\003"
catch {close}
catch {wait}
log_file

set assertion_status [catch {exec python3 $assert_path $scratch} assertion_output]
puts $assertion_output
puts "ARTIFACTS $scratch"
exit $assertion_status

#!/usr/bin/expect -f
# Real-Pi fullscreen regression: reload does not restore outer tool backgrounds.

set timeout 1
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set extension_path [file join $repo_dir "extensions" "index.ts"]
set fixture_path [file join $repo_dir "e2e" "fixtures" "effective-final-level-one-session.jsonl"]
set assert_path [file join $expect_dir "reload-tool-background-assert.py"]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set scratch "/tmp/pi-cc-tools-reload-background-[pid]"
set columns 100
set rows 34
file mkdir $scratch

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc force_fullscreen_repaint {columns rows} {
  global spawn_id
  set pi_pid [exp_pid]
  if {[catch {exec stty columns [expr {$columns + 1}] rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
  if {[catch {exec stty columns $columns rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  wait_for 1 {__PI_CC_TOOLS_REPAINT_DRAIN_SENTINEL__}
  return 1
}

proc capture {path columns rows} {
  log_file
  log_file -noappend $path
  if {![force_fullscreen_repaint $columns $rows]} { return 0 }
  log_file
  return 1
}

proc stop_pi {} {
  catch {send "\003\003"}
  catch {close}
  catch {wait}
  catch {log_file}
}

proc run_mode {mode} {
  global scratch extension_path fixture_path pi_bin columns rows spawn_id
  set root [file join $scratch $mode]
  set cwd [file join $root "cwd"]
  set home [file join $root "home"]
  set agent [file join $root "agent"]
  set session_path [file join $root "session.jsonl"]
  file mkdir $cwd
  file mkdir [file join $home ".pi"]
  file mkdir $agent

  set settings_json [format {{"quietStartup":true,"theme":"dark","outputPad":0,"toolBackground":"%s","clickExpansion":true,"previewLines":3,"groupToolCalls":true,"extensions":["%s"]}} $mode $extension_path]
  foreach path [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]] {
    set settings [open $path "w"]
    puts $settings $settings_json
    close $settings
  }

  set source [open $fixture_path "r"]
  set content [read $source]
  close $source
  set session [open $session_path "w"]
  puts -nonewline $session [string map [list "/tmp/pi-cc-tools-result-summary-acceptance" $cwd] $content]
  close $session

  cd $cwd
  log_file -noappend [file join $root "startup.ansi"]
  spawn env HOME=$home TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent \
    $pi_bin --session $session_path --no-context-files --no-prompt-templates --no-themes --no-skills --tui-mode fullscreen
  stty columns $columns rows $rows

  if {![wait_for 10 {6 lines loaded}]} {
    puts stderr "$mode fixture did not become ready"
    stop_pi
    return 0
  }
  if {![capture [file join $scratch "$mode-before.ansi"] $columns $rows]} {
    puts stderr "$mode pre-reload capture failed"
    stop_pi
    return 0
  }

  log_file -noappend [file join $root "reload.ansi"]
  send -- "/reload\r"
  if {![wait_for 10 {Reloaded keybindings, extensions, skills, prompts, themes, and context files}]} {
    puts stderr "$mode /reload did not finish"
    stop_pi
    return 0
  }
  after 200
  if {![capture [file join $scratch "$mode-after.ansi"] $columns $rows]} {
    puts stderr "$mode post-reload capture failed"
    stop_pi
    return 0
  }
  stop_pi
  return 1
}

puts "PI_VERSION [exec $pi_bin --version]"
foreach mode {outlines transparent} {
  if {![run_mode $mode]} {
    puts "ARTIFACTS $scratch"
    exit 1
  }
}

if {[catch {exec python3 $assert_path $scratch} assertion]} {
  puts stderr $assertion
  puts "ARTIFACTS $scratch"
  exit 1
}
puts $assertion
file delete -force $scratch
puts "PASS reload tool background fullscreen E2E"

#!/usr/bin/expect -f
# Real-Pi fullscreen regression for adaptive ask_parent collapse positioning.

set timeout 1
match_max -d 1000000
set expect_dir [file dirname [file normalize [info script]]]
set repo_dir [file dirname [file dirname $expect_dir]]
set extension_path [expr {[info exists env(EXTENSION_PATH)] ? $env(EXTENSION_PATH) : [file join $repo_dir "extensions" "index.ts"]}]
set fixture_extension [file join $repo_dir "e2e" "fixtures" "side-quests-ask-parent-session-extension.ts"]
set fixture [file join $repo_dir "e2e" "fixtures" "side-quests-ask-parent-viewport-session.jsonl"]
set side_quests_renderer [expr {[info exists env(SIDE_QUESTS_RENDERER)] ? $env(SIDE_QUESTS_RENDERER) : "/Users/asol/.pi/agent/packages/side-quests/renderer/agent-renderer.ts"}]
set pi_bin [expr {[info exists env(PI_BIN)] ? $env(PI_BIN) : "pi"}]
set assert_path [file join $expect_dir "side-quests-ask-parent-viewport-assert.py"]
set locator_path [file join $expect_dir "async-diff-click-assert.py"]
set scratch "/tmp/pi-cc-tools-side-quests-ask-parent-viewport-[pid]"
set cwd [file join $scratch "cwd"]
set home [file join $scratch "home"]
set agent [file join $scratch "agent"]
set columns 100
set rows 40
file mkdir $cwd
file mkdir [file join $home ".pi"]
file mkdir $agent

if {![file exists $side_quests_renderer]} {
  puts stderr "real Side Quests renderer not found: $side_quests_renderer"
  puts stderr "ARTIFACTS $scratch"
  exit 1
}

set settings_json {{"quietStartup":true,"theme":"dark","outputPad":0,"clickExpansion":true,"groupToolCalls":false}}
foreach path [list [file join $agent "settings.json"] [file join $home ".pi" "settings.json"]] {
  set settings [open $path "w"]
  puts $settings $settings_json
  close $settings
}
set source [open $fixture "r"]
set content [read $source]
close $source
set session_path [file join $scratch "session.jsonl"]
set session [open $session_path "w"]
puts -nonewline $session [string map [list "/tmp/pi-cc-tools-side-quests-ask-parent-viewport" $cwd] $content]
close $session

proc wait_for {seconds pattern} {
  set deadline [expr {[clock milliseconds] + $seconds * 1000}]
  while {[clock milliseconds] < $deadline} {
    expect {
      "\033\[c" { send "\033\[?1;2c"; exp_continue -continue_timer }
      "\033\[?u" { send "\033\[?0u"; exp_continue -continue_timer }
      "Trust project folder?" { puts stderr "unexpected project trust prompt"; return 0 }
      -re $pattern { return 1 }
      timeout {}
      eof { return 0 }
    }
  }
  return 0
}

proc drain_repaint {} {
  for {set read 0} {$read < 8} {incr read} {
    after 50
    expect -timeout 0 {
      -re {.+} {}
      timeout {}
      eof { return }
    }
  }
}

proc capture {path columns rows} {
  global spawn_id
  log_file
  set pi_pid [exp_pid]
  # A large unlogged shrink invalidates every wrapped transcript row. Record
  # only Pi's complete repaint after restoring the nominal width.
  if {[catch {exec stty columns [expr {$columns - 20}] rows $rows <@ $spawn_id}]} { return 0 }
  catch {exec kill -WINCH $pi_pid}
  drain_repaint
  log_file -noappend $path
  if {[catch {exec stty columns $columns rows $rows <@ $spawn_id}]} {
    log_file
    return 0
  }
  catch {exec kill -WINCH $pi_pid}
  drain_repaint
  log_file
  return 1
}

proc locate {locator_path path pattern} {
  if {[catch {exec python3 $locator_path locate $path $pattern} result]} { return {} }
  return $result
}

proc find_visible_up {path pattern max_pages columns rows locator_path} {
  for {set attempt 0} {$attempt <= $max_pages} {incr attempt} {
    if {![capture $path $columns $rows]} { return {} }
    set point [locate $locator_path $path $pattern]
    if {[llength $point] == 2} { return $point }
    send -- "\033\[5~"
    drain_repaint
  }
  return {}
}

proc find_bottom_edge {path max_wheels columns rows locator_path} {
  for {set attempt 0} {$attempt <= $max_wheels} {incr attempt} {
    if {![capture $path $columns $rows]} { return {} }
    set detail [locate $locator_path $path "ASK_PARENT_VIEWPORT_DETAIL_60"]
    set following [locate $locator_path $path "ASK_PARENT_VIEWPORT_AFTER_03"]
    if {[llength $detail] == 2 && [llength $following] == 2} { return $detail }
    send -- "\033\[<65;50;20M"
    drain_repaint
  }
  return {}
}

proc click {x y} {
  send -- "\033\[<0;${x};${y}M\033\[<0;${x};${y}m"
}

proc fail {message scratch} {
  puts stderr $message
  send "\003\003"
  catch {close}
  catch {wait}
  log_file
  puts "ARTIFACTS $scratch"
  exit 1
}

puts "PI_VERSION [exec $pi_bin --version]"
cd $cwd
log_file -noappend [file join $scratch "startup.ansi"]
spawn env HOME=$home TERM=xterm-256color COLORTERM=truecolor COLUMNS=$columns LINES=$rows PI_OFFLINE=1 PI_CODING_AGENT_DIR=$agent SIDE_QUESTS_RENDERER=$side_quests_renderer \
  $pi_bin --session $session_path --no-context-files --no-prompt-templates --no-themes --no-extensions --no-skills \
  -e $fixture_extension -e $extension_path --tui-mode fullscreen
stty columns $columns rows $rows

if {![wait_for 10 {ASK_PARENT_VIEWPORT_AFTER_45}]} { fail "fixture did not become ready" $scratch }
set collapsed [file join $scratch "collapsed.ansi"]
set collapsed_point [find_visible_up $collapsed "ASK PARENT" 8 $columns $rows $locator_path]
if {[llength $collapsed_point] != 2} { fail "collapsed ask_parent banner was not found" $scratch }
lassign $collapsed_point _collapsed_x collapsed_y
click 50 $collapsed_y
if {![wait_for 3 {ASK_PARENT_VIEWPORT_DETAIL_20}]} { fail "ask_parent did not expand" $scratch }

# Put the viewport fully inside the expanded banner.
send -- "\033\[6~"
drain_repaint
if {![capture [file join $scratch "whole-before.ansi"] $columns $rows]} { fail "whole-before capture failed" $scratch }
click 50 20
drain_repaint
if {![capture [file join $scratch "whole-after.ansi"] $columns $rows]} { fail "whole-after capture failed" $scratch }

# Reopen and put the expanded bottom edge beside the following transcript.
set recollapsed [file join $scratch "recollapsed.ansi"]
set recollapsed_point [find_visible_up $recollapsed "ASK PARENT" 8 $columns $rows $locator_path]
if {[llength $recollapsed_point] != 2} { fail "collapsed ask_parent banner could not be reopened" $scratch }
lassign $recollapsed_point _recollapsed_x recollapsed_y
click 50 $recollapsed_y
if {![wait_for 3 {ASK_PARENT_VIEWPORT_DETAIL_20}]} { fail "ask_parent did not reopen" $scratch }
send -- "\033\[6~"
drain_repaint
send -- "\033\[6~"
drain_repaint
set bottom_path [file join $scratch "bottom-before.ansi"]
set bottom_point [find_bottom_edge $bottom_path 40 $columns $rows $locator_path]
if {[llength $bottom_point] != 2} { fail "expanded ask_parent bottom edge was not positioned" $scratch }
lassign $bottom_point bottom_x bottom_y
click $bottom_x $bottom_y
drain_repaint
if {![capture [file join $scratch "bottom-after.ansi"] $columns $rows]} { fail "bottom-after capture failed" $scratch }

# A rapid second or third native click restores expanded geometry before Pi
# applies word or line selection.
set rollback_collapsed [file join $scratch "rollback-collapsed.ansi"]
set rollback_point [find_visible_up $rollback_collapsed "ASK PARENT" 8 $columns $rows $locator_path]
if {[llength $rollback_point] != 2} { fail "ask_parent rollback fixture was not found" $scratch }
lassign $rollback_point _rollback_x rollback_y
click 50 $rollback_y
if {![wait_for 3 {ASK_PARENT_VIEWPORT_DETAIL_08}]} { fail "ask_parent rollback fixture did not expand" $scratch }
send -- "\033\[6~"
drain_repaint
if {![capture [file join $scratch "rollback-before.ansi"] $columns $rows]} { fail "rollback-before capture failed" $scratch }
click 50 20
after 40
click 50 20
drain_repaint
if {![capture [file join $scratch "double-after.ansi"] $columns $rows]} { fail "double-after capture failed" $scratch }
after 700
click 50 20
after 40
click 50 20
after 40
click 50 20
drain_repaint
if {![capture [file join $scratch "triple-after.ansi"] $columns $rows]} { fail "triple-after capture failed" $scratch }

send "\003\003"
catch {close}
catch {wait}
log_file
set assertion_status [catch {exec python3 $assert_path $scratch} assertion_output]
puts $assertion_output
puts "ARTIFACTS $scratch"
exit $assertion_status
